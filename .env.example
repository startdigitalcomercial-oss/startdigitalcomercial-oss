# ============================================================
# StartDigital RH — variaveis de ambiente
# Cole estas variaveis na Vercel: Settings > Environment Variables
# REGRA SAGRADA: mudou variavel = fazer Redeploy
# ============================================================

# --- Endereco publico do sistema (usado nos links das mensagens) ---
APP_URL=https://start-rh.vercel.app

# --- Banco de dados (Supabase - projeto start-rh) ---
SUPABASE_URL=https://jurryyrdwgcasvvficty.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_AQUI

# --- Acesso ao painel administrativo ---
ADMIN_PASSWORD=troque-esta-senha
APP_SECRET=gere-uma-chave-aleatoria-longa

# --- E-mail (Resend) ---
RESEND_API_KEY=
# Sem dominio verificado use exatamente: StartDigital <onboarding@resend.dev>
MAIL_FROM=StartDigital <onboarding@resend.dev>
# Copia oculta de todo envio (opcional)
MAIL_BCC=

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- SMS (opcional - Twilio). Sem isso o SMS fica como "envio manual". ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
